# Access token of one Billy company: in Billy, Settings -> Access tokens -> Create access token.
BILLY_ACCESS_TOKEN=
# Base URL of the Billy API. Default https://api.billysbilling.com/v2; only api.billysbilling.com and api.billy.dk
# are accepted unless BILLY_ALLOW_CUSTOM_BASE_URL=true (loopback http is allowed for local mocks).
# BILLY_BASE_URL=https://api.billysbilling.com/v2
# BILLY_ALLOW_CUSTOM_BASE_URL=false
BILLY_TIMEOUT_MS=30000
BILLY_MAX_CONCURRENCY=4
# Largest response body read from the upstream API (bytes, max 104857600).
BILLY_MAX_RESPONSE_BYTES=10485760

# Write tools are disabled unless this is true.
BILLY_ENABLE_WRITES=false
# Comma-separated tool names to disable (with or without the billy_ prefix).
BILLY_DISABLED_TOOLS=
# JSONL audit trail; write tools refuse to run if it cannot be written.
BILLY_AUDIT_LOG=

# HTTP transport. A bearer token (>= 32 printable ASCII characters, e.g.
# `openssl rand -hex 32`) is required unless the server binds to loopback.
MCP_HTTP_TOKEN=
# Bind address (HOST is also read; MCP_HTTP_HOST wins):
# MCP_HTTP_HOST=127.0.0.1
# PORT=3000
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOWED_HOSTS=
# MCP_MAX_BODY_BYTES=10485760
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
# Allow any browser origin (requires a token):
# MCP_ALLOW_ANY_ORIGIN=false
# Non-loopback bind without a token; isolated networks only:
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false
